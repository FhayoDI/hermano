{
  "title": "StockFácil – Monitoramento de Infraestrutura",
  "uid": "stockfacil-infra",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU em Uso (%)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memória em Uso (%)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "RAM"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memória Total",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime do Servidor",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_time_seconds - node_boot_time_seconds",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Uso de CPU ao Longo do Tempo",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uso de Memória ao Longo do Tempo",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "RAM Usada"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "RAM Livre"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tráfego de Rede (bytes/s)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo\"}[2m])",
          "legendFormat": "Recebido – {{device}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo\"}[2m])",
          "legendFormat": "Enviado – {{device}}"
        }
      ]
    }
  ]
}
